<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    tools:context=".MainActivity">

    <!-- Top Status Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statusBarContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Settings Icon (Top-Left) -->
        <ImageView
            android:id="@+id/ivSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_gear"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Network Warning Icon (Top-Right, next to alarm bell) -->
        <ImageView
            android:id="@+id/ivNetworkWarning"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_warning"
            android:contentDescription="Connection Warning"
            android:visibility="gone"
            android:padding="10dp"
            app:layout_constraintEnd_toStartOf="@id/ivAlarmBell"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"/>

        <!-- Alarm Bell Icon (Top-Right) -->
        <ImageView
            android:id="@+id/ivAlarmBell"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_bell_active"
            android:contentDescription="Alarms Toggle"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Central Clickable Area for Toggling -->
    <FrameLayout
        android:id="@+id/centralClickArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Time Container (HH:mm) - Giant and Bold -->
        <LinearLayout
            android:id="@+id/layoutTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textSize="180sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tvColon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="180sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="20dp"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tvMinutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="34"
                android:textSize="180sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:includeFontPadding="false"/>

        </LinearLayout>

        <!-- Glucose Container (mmol/L) - Giant, Bold and Compact -->
        <LinearLayout
            android:id="@+id/layoutGlucose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGlucose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.5 →"
                android:textSize="180sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tvGlucoseUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ммоль/л"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="36dp"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"/>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

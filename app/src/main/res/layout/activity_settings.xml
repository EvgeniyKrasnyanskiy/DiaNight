<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Data Source Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Источник данных"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/rgDataSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbSourceNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Сетевой (WiFi / xDrip+ Web Service)"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/colorPrimary"
                        android:textSize="14sp"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rbSourceBroadcast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Локальный (Broadcast от xDrip+ без сети)"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/colorPrimary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                </RadioGroup>

                <TextView
                    android:id="@+id/tvDataSourceHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Сетевой режим требует настройки IP-адреса и ключа API Secret. Локальный режим работает без сети через встроенный обмен на одном телефоне."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Core Setup Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCoreSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Основная конфигурация"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <!-- IP Address Row with Help Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_ip_address"
                        app:hintTextColor="@color/colorPrimary"
                        app:boxStrokeColor="@color/colorPrimary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIpAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Help Manual Button -->
                    <ImageView
                        android:id="@+id/ivHelp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_help"
                        android:contentDescription="Help Manual"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:layout_marginStart="8dp"
                        app:tint="@color/colorPrimary"/>

                </LinearLayout>

                <!-- API Secret / Key -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_api_secret"
                    app:hintTextColor="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiSecret"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Actions row for Test & AutoSearch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <!-- Test Connection Button -->
                    <Button
                        android:id="@+id/btnTestConnection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Проверить связь"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/bg_input"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_marginEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                    <!-- Auto Search Button -->
                    <Button
                        android:id="@+id/btnAutoSearchBeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Автопоиск (Beta)"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/colorPrimary"
                        style="@style/Widget.MaterialComponents.Button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                </LinearLayout>

                <!-- Save & Exit Button (Full width) -->
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Применить настройки"
                    android:textColor="@color/black"
                    android:backgroundTint="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Board Configuration Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настройки табло"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Toggle Interval -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_toggle_interval"
                    app:hintTextColor="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etToggleInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Text Color Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_text_color"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Row with scrollable presets and custom color actions combined on a single line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <!-- Scrollable row of 10 preset colors (takes remaining space on left) -->
                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- White -->
                            <Button
                                android:id="@+id/btnColorWhite"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#FFFFFF"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>
                            
                            <!-- Grey -->
                            <Button
                                android:id="@+id/btnColorGrey"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#8E8E93"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Dark Grey -->
                            <Button
                                android:id="@+id/btnColorDarkGrey"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#3A3A3C"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Green -->
                            <Button
                                android:id="@+id/btnColorGreen"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#34C759"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Blue -->
                            <Button
                                android:id="@+id/btnColorBlue"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#007AFF"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Amber / Orange -->
                            <Button
                                android:id="@+id/btnColorOrange"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#FF9500"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Soft Red -->
                            <Button
                                android:id="@+id/btnColorRed"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#FF3B30"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Purple -->
                            <Button
                                android:id="@+id/btnColorPurple"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#AF52DE"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Yellow / Gold -->
                            <Button
                                android:id="@+id/btnColorYellow"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#FFCC00"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_marginEnd="8dp"
                                android:padding="0dp"/>

                            <!-- Teal -->
                            <Button
                                android:id="@+id/btnColorTeal"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:backgroundTint="#30B0C7"
                                style="@style/Widget.MaterialComponents.Button"
                                android:padding="0dp"/>

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Divider vertical -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/color_disabled_grey"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>

                    <!-- Color Preview View (Placed to the left of Custom Button) -->
                    <View
                        android:id="@+id/viewColorPreview"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:background="#FFFFFF"/>

                    <!-- Custom Color Button (Aligned right) -->
                    <Button
                        android:id="@+id/btnColorCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_custom_color"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/colorPrimary"
                        style="@style/Widget.MaterialComponents.Button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Alarm Sound Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_alarm_sound"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Selected Ringtone Name -->
                    <TextView
                        android:id="@+id/tvRingtoneName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_ringtone_name"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginEnd="16dp"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <!-- Choose Melody Button -->
                    <Button
                        android:id="@+id/btnChooseRingtone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_choose_ringtone"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/bg_input"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_marginEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                    <!-- Test Melody Button -->
                    <Button
                        android:id="@+id/btnTestRingtone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_test_alarm_start"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/colorPrimary"
                        style="@style/Widget.MaterialComponents.Button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>

                <!-- Snooze Interval Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_snooze_interval"
                    app:hintTextColor="@color/colorPrimary"
                    app:boxStrokeColor="@color/colorPrimary"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSnoozeInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Time Slots Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_day_time_range"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Day Start -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_day_start"
                        app:hintTextColor="@color/colorPrimary"
                        app:boxStrokeColor="@color/colorPrimary"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDayStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="datetime"
                            android:text="08:00"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Day End -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_day_end"
                        app:hintTextColor="@color/colorPrimary"
                        app:boxStrokeColor="@color/colorPrimary"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDayEnd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="datetime"
                            android:text="22:00"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ночной диапазон рассчитывается автоматически от Конца дня до Начала дня."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Day Thresholds Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_day_thresholds"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Day Low -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_low_threshold"
                        app:hintTextColor="@color/colorPrimary"
                        app:boxStrokeColor="@color/colorPrimary"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDayLow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Day High -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_high_threshold"
                        app:hintTextColor="@color/colorPrimary"
                        app:boxStrokeColor="@color/colorPrimary"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDayHigh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Night Thresholds Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_night_thresholds"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Night Low -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_low_threshold"
                        app:hintTextColor="@color/colorPrimary"
                        app:boxStrokeColor="@color/colorPrimary"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNightLow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Night High -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_high_threshold"
                        app:hintTextColor="@color/colorPrimary"
                        app:boxStrokeColor="@color/colorPrimary"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNightHigh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- App Update Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Обновление приложения"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <CheckBox
                    android:id="@+id/chkAutoCheckUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Проверять обновления автоматически"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/colorPrimary"
                    android:textSize="14sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <!-- Check Update Button -->
                    <Button
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Проверить"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/bg_input"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_marginEnd="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>

                    <!-- Download Button -->
                    <Button
                        android:id="@+id/btnDownloadUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Скачать APK"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/color_safe_green"
                        style="@style/Widget.MaterialComponents.Button"
                        android:visibility="gone"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUpdateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Обновления не проверялись"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <!-- Cancel Button -->
            <Button
                android:id="@+id/btnCancelBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/bg_input"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_save"
                android:textColor="@color/black"
                android:backgroundTint="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <!-- Footer / Version & Author Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvVersionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Версия: 1.1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Разработчик: Евгений Краснянский\nEmail: Evgeniy.Krasnyanskiy@gmail.com"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
